# Everything is optional. With no keys the platform runs fully offline.
# OPENAI_API_KEY=sk-...        # enables text-embedding-3-small embeddings
# USE_LLM_JUDGE=1              # enables the LLM judge in Stage 3 (needs OPENAI_API_KEY)
# RELEVANCE_THRESHOLD=0.75
# EMBEDDING_DIM=512
# DB_PATH=agent_network.db
# ALLOW_PRIVATE_WEBHOOKS=1     # set 0 in production (SSRF protection)
